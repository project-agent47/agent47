{
  "name": "agent47",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local-first desktop task agent",
  "main": "dist/main/main.cjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:preview": "playwright test",
    "design:build": "node scripts/build-design.mjs",
    "design:check": "node scripts/build-design.mjs --check",
    "lint": "eslint src tests scripts",
    "desktop": "electron .",
    "smoke:model": "tsx scripts/smoke-model.ts",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "test:desktop:live": "node scripts/e2e-desktop-live.mjs",
    "test:capabilities:live": "node scripts/e2e-capabilities-live.mjs",
    "test:permissions:live": "node scripts/e2e-permissions-live.mjs",
    "test:workbench:live": "node scripts/e2e-workbench-live.mjs",
    "test:decisions:live": "node scripts/e2e-decisions-live.mjs",
    "test:workspace:native": "node scripts/e2e-workspace-native.mjs",
    "test:materials:native": "node scripts/e2e-materials-native.mjs",
    "test:pause:native": "node scripts/e2e-pause-native.mjs",
    "test:web-workspace:native": "node scripts/e2e-web-workspace-native.mjs",
    "test:web-context:live": "node scripts/e2e-web-context-live.mjs",
    "test:agent-browser:native": "node scripts/e2e-agent-browser-native.mjs",
    "test:agent-browser:live": "node scripts/e2e-agent-browser-live.mjs",
    "test:agent-browser:public-live": "node scripts/e2e-agent-browser-public-live.mjs",
    "test:browser-observation:live": "node scripts/e2e-browser-observation-live.mjs",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.67",
    "@fontsource/geist": "5.2.8",
    "@fontsource/geist-mono": "5.2.7",
    "ai": "7.0.137",
    "lucide-react": "^0.468.0",
    "monaco-editor": "0.57.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "undici": "^7.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.7.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "playwright": "^1.56.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "dompurify": "3.4.16",
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "dev.agent47.desktop",
    "productName": "Agent47",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
